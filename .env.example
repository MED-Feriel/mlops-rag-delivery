# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=livraison
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_32CHARS

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_GROUP_ID=rag-etl-group

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=livraison_rag

# Ollama / LLM
OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11434
OLLAMA_MODEL=gemma3:1b

# Embedding
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=64

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# Logstash
LOGSTASH_HOST=logstash
LOGSTASH_PORT=5044

# Simulation
SIMULATION_SEED=42

# Cache Redis des embeddings de questions
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TTL_EMBEDDING_SEC=3600
EMBEDDING_CACHE_ENABLED=true
# Cache Redis des réponses RAG complètes (B.2) — OFF par défaut.
# ⚠️ données temps réel : une réponse cachée peut être périmée. N'activer
# (true) + garder un TTL court que pour des charges démo / FAQ stables.
ANSWER_CACHE_ENABLED=false
REDIS_TTL_ANSWER_SEC=300

# ── Sécurité API : auth JWT + RBAC + rate limiting + CORS (MLOPS-117) ──
# Activer en production (true). En dev/démo : false → accès libre.
AUTH_ENABLED=false
JWT_SECRET=CHANGE_ME_MIN_32_RANDOM_CHARS
JWT_EXPIRY_MIN=60
# Utilisateurs & rôles (admin = tout ; reader = query/chat).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
READONLY_USERNAME=reader
READONLY_PASSWORD=CHANGE_ME
# Jeton de service statique (ex: Open WebUI comme OPENAI_API_KEY). Vide = off.
API_SERVICE_TOKEN=
# Clés API service-à-service au format JSON :
#   API_KEYS={"rag_xxx":{"name":"ingestion","roles":["service"]}}
API_KEYS={}
# CORS : origines autorisées (CSV). NE PAS mettre * en production.
CORS_ORIGINS=http://localhost:8501,http://localhost:3001
# Rate limiting : requêtes/minute par identité, selon le rôle.
RATE_LIMIT_USER=60
RATE_LIMIT_ADMIN=300
RATE_LIMIT_SERVICE=500

# ── Secrets d'infrastructure (MLOPS-118) — placeholders, à remplir ──
GRAFANA_PASSWORD=CHANGE_ME
AIRFLOW_PASSWORD=CHANGE_ME
QDRANT_API_KEY=CHANGE_ME
KAFKA_SECRET=CHANGE_ME
ELASTIC_PASSWORD=CHANGE_ME
KIBANA_PASSWORD=CHANGE_ME
# Backend de gestion des secrets : env (dev) | vault | aws
SECRETS_BACKEND=env
