{
  "id": null,
  "uid": "rag_cache_detail",
  "title": "RAG — Cache Redis (détaillé)",
  "tags": ["rag", "cache", "redis"],
  "timezone": "browser",
  "schemaVersion": 37,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "gauge",
      "title": "Hit ratio — cache embeddings",
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "100 * sum(rag_embedding_cache_hits_total) / clamp_min(sum(rag_embedding_cache_hits_total) + sum(rag_embedding_cache_misses_total), 1)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 30}, {"color": "green", "value": 60}]}}}
    },
    {
      "type": "gauge",
      "title": "Hit ratio — cache réponses",
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "100 * sum(rag_answer_cache_hits_total) / clamp_min(sum(rag_answer_cache_hits_total) + sum(rag_answer_cache_misses_total), 1)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}}
    },
    {
      "type": "stat",
      "title": "Latence embedding p95",
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum(rate(rag_embedding_duration_seconds_bucket[5m])) by (le))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 3}}
    },
    {
      "type": "timeseries",
      "title": "Cache embeddings — hits vs misses (taux/s)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(rag_embedding_cache_hits_total[5m]))", "legendFormat": "hits/s", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(rag_embedding_cache_misses_total[5m]))", "legendFormat": "misses/s", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "decimals": 3}}
    },
    {
      "type": "timeseries",
      "title": "Latence embedding p50 / p95 (s)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.50, sum(rate(rag_embedding_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum(rate(rag_embedding_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 3}}
    }
  ],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {}
}
